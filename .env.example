# Copia este archivo a .env (está en .gitignore y en .dockerignore) y rellénalo.

# Hoja que usa el servidor. En local apunta SIEMPRE a la COPIA de pruebas,
# nunca a la hoja de producción (la de producción solo va en Cloud Run).
SPREADSHEET_ID=

# Solo para las pruebas de integración: copia de pruebas. Las pruebas leen
# esta variable y NUNCA SPREADSHEET_ID, así no pueden tocar producción por error.
TEST_SPREADSHEET_ID=

# Token que exige el servidor en `authorization: Bearer <token>` (obligatorio, también con --fake).
# En local usa uno propio, DISTINTO del de Cloud Run. Genéralo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# Opcionales (valores por defecto: 127.0.0.1 y 8000; Cloud Run inyecta PORT=8080)
# HOST=127.0.0.1
# PORT=8000
